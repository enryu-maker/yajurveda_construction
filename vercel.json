{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/ourcompany", "destination": "/our-company", "permanent": true },
    { "source": "/financialplan", "destination": "/financial-plan", "permanent": true },
    { "source": "/:lng(hi|mr)/ourcompany", "destination": "/:lng/our-company", "permanent": true },
    { "source": "/:lng(hi|mr)/financialplan", "destination": "/:lng/financial-plan", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
